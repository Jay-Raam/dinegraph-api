# Server Configuration
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
# Use * only for local development. Production must use an explicit origin.
CORS_ORIGIN=http://localhost:3000

# PostgreSQL / Supabase Database Connection
# Format: postgresql://[USER]:[PASSWORD]@[HOST]:[PORT]/[DATABASE]?sslmode=require
# Note: For Supabase, use port 5432 (direct) or 6543 (connection pooler - recommended for serverless/high concurrency)
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?sslmode=require

# DB Pool Settings
DB_POOL_MIN=2
DB_POOL_MAX=20
DB_TIMEOUT_MS=10000
DB_IDLE_TIMEOUT_MS=30000

# Security & Auth
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-long
JWT_ISSUER=dinegraph-api
JWT_AUDIENCE=dinegraph-client
API_KEY=optional-api-key-for-admin-endpoints

# Logging
LOG_LEVEL=debug
